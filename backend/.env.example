# Server Configuration
PORT=3000

# Supabase — find these in your Supabase project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT — must be at least 32 characters, keep secret
# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# Admin Emails — comma-separated list of email addresses with admin access
ADMIN_EMAILS=admin@example.com
